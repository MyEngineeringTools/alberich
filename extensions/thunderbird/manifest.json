{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Alberich Mail Companion",
  "version": "1.0.16",
  "description": "__MSG_extDescription__",
  "default_locale": "de",
  "author": "Dipl.-Ing.(FH) Christian Peter Kaiser / My Engineering Tools",
  "homepage_url": "https://alberich.pro/",
  "browser_specific_settings": {
    "gecko": {
      "id": "alberich-mail@alberich.pro",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "compose",
    "messagesRead",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "compose_action": {
    "default_title": "__MSG_composeTitle__",
    "default_label": "Alberich Mail Companion",
    "default_popup": "popup/popup.html",
    "default_area": "maintoolbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "message_display_action": {
    "default_title": "__MSG_messageTitle__",
    "default_label": "Alberich Mail Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
